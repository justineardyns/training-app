{
  "name": "training-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gratis personal-trainer-PWA: plant, coacht en logt je trainingen. Data blijft in je eigen privé-repo.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "e2e": "playwright test --trace off",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.1",
    "web-push": "^4.0.0"
  }
}
